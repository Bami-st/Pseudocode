# Environment Configuration Example
# Copy this file to .env for local overrides. Never commit secrets.

# Execution Environment
NODE_ENV=development
PORT=3000

# Job & System Configuration (used in Part A test verification)
JOB_MAX_ATTEMPTS=3
JOB_BASE_DELAY_MS=5000
JOB_MAX_DELAY_MS=300000

# Test Verification Options
VERIFY_VERBOSE=true
TEST_TIMEOUT_MS=10000

# Test Database (Part A1.2 — order handler verification)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASSWORD=your_password_here
TEST_DB_NAME=postgres
TEST_DB_SSL=false
